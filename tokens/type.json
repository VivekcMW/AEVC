{
  "families": {
    "heading": "'Comfortaa', system-ui, sans-serif",
    "body": "'Poppins', system-ui, sans-serif",
    "devanagari": "'Anek Devanagari', system-ui, sans-serif"
  },
  "scale": {
    "xs": "0.8125rem",
    "sm": "0.9375rem",
    "base": "1rem",
    "lg": "1.125rem",
    "xl": "1.375rem",
    "2xl": "1.75rem",
    "3xl": "2.25rem",
    "4xl": "3rem",
    "5xl": "3.75rem",
    "6xl": "4.5rem",
    "display-sm": "clamp(2.25rem, 7vw, 3.5rem)",
    "display-md": "clamp(2.75rem, 9vw, 5rem)",
    "display-lg": "clamp(3rem, 11vw, 7rem)"
  },
  "weight": {
    "regular": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700",
    "light": "300"
  },
  "leading": {
    "tight": "1.1",
